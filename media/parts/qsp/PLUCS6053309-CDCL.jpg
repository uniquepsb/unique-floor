    <script>
        function loadMetaPixel() {
            // Prevent duplicate initialization if the callback runs more than once.
            if (window.metaPixelLoaded) {
                return;
            }

            window.metaPixelLoaded = true;

            !function (f, b, e, v, n, t, s) {
                if (f.fbq) return;

                n = f.fbq = function () {
                    n.callMethod
                        ? n.callMethod.apply(n, arguments)
                        : n.queue.push(arguments);
                };

                if (!f._fbq) f._fbq = n;

                n.push = n;
                n.loaded = true;
                n.version = '2.0';
                n.queue = [];

                t = b.createElement(e);
                t.async = true;
                t.src = v;

                s = b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t, s);
            }(
                window,
                document,
                'script',
                'https://connect.facebook.net/en_US/fbevents.js'
            );

            fbq('consent', 'grant');
            fbq('init', '339654093850344');
            fbq('track', 'PageView');
        }

        function rejectMetaPixel() {
            if (window.fbq) {
                fbq('consent', 'revoke');
            }
        }
    </script>


    
    
    

    
    
   
    
